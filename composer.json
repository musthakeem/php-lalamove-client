{
  "name": "jmusthakeem/lalamove",
  "autoload": {
    "psr-4": {
      "JM\\Lalamove\\": "src/"
    }
  },
  "description": "PHP Lalamove client library",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Jithu Musthakeem",
      "email": "jmusthak.devlp@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.7",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "suggest": {
    "monolog/monolog": "Allows for more advanced logging of API requests and responses"
  }
}
